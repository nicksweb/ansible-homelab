# ============================================================================
# OPTIONAL: SERVICE-BASED GROUPINGS
# ============================================================================
# These overlap with above but useful for specific operations

# All machines with NTP requirements
[ntp_servers]
unifi
cipi

# All machines that should run speedtest
[speedtest_nodes]
172.16.0.60

# All machines needing Jekyll
[jekyll_servers]
# jekyll-blog-01


# ============================================================================
# PARENT GROUPS FOR BULK OPERATIONS
# ============================================================================
# Meta-groups for targeting multiple categories at once

[linux]
# Parent group containing ALL Linux machines
# Used for bulk operations like apt-upgrade

[linux:children]
ubuntu
raspberrypi
setup
docker
master
lampstack
debian
proxmox
bitwarden
k3s-sapve01
service_servers
workstations
surveillance

# All machines in the infrastructure
[all_infrastructure:children]
proxmox
servers
workstations

[servers:children]
lampstack
docker
bitwarden
service_servers
debian
ubuntu


# ============================================================================
# GLOBAL VARIABLES FOR ALL LINUX MACHINES
# ============================================================================
# These apply to all hosts in the [linux] group unless overridden

[linux:vars]
# Python interpreter for Ansible
ansible_python_interpreter=/usr/bin/python3

# SSH connection settings
ansible_connection=ssh

# Default SSH user (override per-host if needed)
ansible_user=localadmin

# Use sudo for privilege escalation
ansible_become=yes
ansible_become_method=sudo

# SSH options
ansible_ssh_common_args="-o StrictHostKeyChecking=accept-new"


# ============================================================================
# PROXMOX-SPECIFIC VARIABLES
# ============================================================================

[proxmox:vars]
# Proxmox hosts are accessed as root
# (already set per-host with ansible_user=root)


