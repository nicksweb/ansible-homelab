# Managed by Ansible (vhosts role) — direct HTTPS for {{ vhosts_item.hostname }}.
# LAN clients arrive here via the UDM record; everyone else via the tunnel.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ vhosts_item.hostname }};

    ssl_certificate     /etc/letsencrypt-host/live/{{ vhosts_item.hostname }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt-host/live/{{ vhosts_item.hostname }}/privkey.pem;
    include conf.d/include/ssl-ciphers.conf;

    # Resolved per request via Docker's DNS, so a stopped upstream container
    # can't stop NPM itself from starting.
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $vhosts_upstream {{ vhosts_item.service or vhosts_default_service }};

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $vhosts_connection_upgrade;
        proxy_pass $vhosts_upstream;
    }
}
