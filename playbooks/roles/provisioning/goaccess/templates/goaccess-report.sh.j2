#!/usr/bin/env bash
# Managed by Ansible (provisioning/goaccess). Regenerates one GoAccess report
# per Apache vhost, plus an index, into {{ goaccess_webroot }}.
# Sites are discovered from /etc/apache2/vhosts.d (ServerName), so new vhosts
# appear without editing this script. Run by goaccess-report.timer and by
# Apache's logrotate (prerotate) so the tail of each log is never missed.
set -euo pipefail

LOG_DIR=/var/log/apache2
OUT_DIR="{{ goaccess_webroot }}"
DB_DIR="{{ goaccess_db_dir }}"
SKIP=" {{ goaccess_skip | join(' ') }} "

exec 9>/run/goaccess-report.lock
flock -n 9 || { echo "another report run is in progress"; exit 0; }

mkdir -p "$OUT_DIR" "$DB_DIR"

mapfile -t SITES < <(
  grep -hoiE '^\s*ServerName\s+\S+' /etc/apache2/vhosts.d/*.conf 2>/dev/null \
    | awk '{print tolower($2)}' | sort -u
)

done_sites=()
for site in "${SITES[@]}"; do
  [[ "$SKIP" == *" $site "* ]] && continue
  log="$LOG_DIR/$site.access.log"
  [ -s "$log" ] || continue
  mkdir -p "$OUT_DIR/$site" "$DB_DIR/$site"
  goaccess "$log" \
    --log-format=COMBINED \
    --persist --restore --db-path="$DB_DIR/$site" \
    --html-report-title="$site" \
    {{ goaccess_args }} \
    --no-progress \
    -o "$OUT_DIR/$site/.index.tmp.html" 2>/dev/null \
  && mv -f "$OUT_DIR/$site/.index.tmp.html" "$OUT_DIR/$site/index.html" \
  && done_sites+=("$site") \
  || echo "$(date '+%F %T') goaccess failed for $site" >&2
done

GENERATED_AT="$(date '+%F %T %Z')"
{
  cat <<'HTML'
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Visitor stats</title>
<style>
  body { font-family: -apple-system, Segoe UI, Roboto, sans-serif; max-width: 640px; margin: 3rem auto; padding: 0 1rem; color: #1a1a1a; background: #fff; }
  h1 { font-size: 1.4rem; }
  ul { list-style: none; padding: 0; }
  li { margin: 0.5rem 0; }
  a { display: block; padding: 0.75rem 1rem; background: #f4f4f5; border-radius: 8px; text-decoration: none; color: #1a1a1a; font-weight: 500; }
  a:hover { background: #e4e4e7; }
  .meta { color: #666; font-size: 0.85rem; margin-top: 2rem; }
  @media (prefers-color-scheme: dark) {
    body { background: #111; color: #eee; }
    a { background: #222; color: #eee; }
    a:hover { background: #2c2c2c; }
    .meta { color: #999; }
  }
</style>
</head>
<body>
HTML
  echo "<h1>Visitor stats — $(hostname -f)</h1>"
  echo "<ul>"
  for site in "${done_sites[@]}"; do
    echo "  <li><a href=\"$site/\">$site</a></li>"
  done
  echo "</ul>"
  echo "<p class=\"meta\">Regenerated every {{ goaccess_interval }} from Apache access logs (history kept in $DB_DIR).<br>Last regenerated: $GENERATED_AT</p>"
  echo "</body></html>"
} > "$OUT_DIR/.index.tmp.html"
mv -f "$OUT_DIR/.index.tmp.html" "$OUT_DIR/index.html"
chmod -R a+rX "$OUT_DIR"
