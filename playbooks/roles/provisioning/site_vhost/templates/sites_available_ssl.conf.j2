<VirtualHost *:443>
    ServerName {{ site_vhost_hostname }}
    DocumentRoot {{ site_vhost_effective_webroot }}
    # Per-vhost snippets shared by every site (e.g. CrowdSec bans). Apache
    # doesn't inherit rewrite rules into vhosts, so they're included here.
    IncludeOptional /etc/apache2/vhost-common.d/*.conf
    # This site only (vhosts options such as noindex / access: trusted).
    IncludeOptional /etc/apache2/vhost-extra.d/{{ site_vhost_hostname }}/*.conf
    SSLEngine on
    SSLCertificateFile {{ site_vhost_cert_dir }}/fullchain.pem
    SSLCertificateKeyFile {{ site_vhost_cert_dir }}/privkey.pem
    ErrorLog ${APACHE_LOG_DIR}/{{ site_vhost_conf_name }}.error.log
    CustomLog ${APACHE_LOG_DIR}/{{ site_vhost_conf_name }}.access.log combined
</VirtualHost>
