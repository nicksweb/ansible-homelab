# Copy to config.env and adjust as needed. config.env is gitignored.
# Never put API tokens or other secrets in this file — credentials are read
# directly from <repo root>/.api-auth.env (see README.md "Credentials").

INTERNAL_DOMAIN=in.example.com

# Proxmox
PVE_STORAGE=storage                # rootdir/images pool — must exist on every node you provision to
PVE_TEMPLATE_STORAGE=local         # vztmpl-capable storage
PVE_TEMPLATE=ubuntu-24.04-standard_24.04-1_amd64.tar.zst   # match whatever LXC template(s) you've downloaded on your nodes
PVE_BRIDGE=vmbr0

# Empty = native/untagged network. Set to a numeric tag to use a specific VLAN
# (only if that VLAN actually has a working DHCP scope on your trunk).
PVE_VLAN_TAG=

DEFAULT_CORES=2
DEFAULT_MEMORY_MB=2048
DEFAULT_DISK_GB=30

ADMIN_USER=localadmin
TIMEZONE=Australia/Brisbane
PROVISIONING_SSH_KEY=$HOME/.ssh/homelab_provisioning

# Optional. Only used when --enable-tls is passed. Empty is fine — certbot
# registers with --register-unsafely-without-email.
LETSENCRYPT_EMAIL=

# UniFi Dream Machine (UDM) integration — required for the DHCP reservation
# and internal DNS record steps. Find your network's object id via the
# legacy REST API (GET /proxy/network/api/s/<site>/rest/networkconf) or by
# inspecting an existing reservation. Reservation range must sit outside your
# router's dynamic DHCP pool.
UDM_NETWORK_ID=
UDM_RESERVATION_RANGE_START=172.16.0.100
UDM_RESERVATION_RANGE_END=172.16.0.159

# Beszel monitoring agent (https://beszel.dev) — installed by default on every
# container unless --skip-beszel is passed. BESZEL_HUB_KEY is the hub's own
# SSH public key (not secret), from its Settings > Add System page. The
# universal token itself (secret) goes in .api-auth.env as
# BESZEL_UNIVERSAL_CODE, not here.
BESZEL_HUB_URL=
BESZEL_HUB_KEY=
BESZEL_PORT=45876
