# Copy to config.env and adjust as needed. config.env is gitignored.
# Never put API tokens or other secrets in this file — credentials are read
# directly from the locations documented in README.md, primarily
# <repo root>/.api-auth.env (mode 600, gitignored).

SERVER_DOMAIN=example.com

# BinaryLane defaults (see README.md "Choosing region/plan/image" for the
# full list retrieved from the API).
BINARYLANE_REGION=bne
# Tried in this order if the primary region has no host capacity right now
# (a real, observed condition — "Unable to find a suitable host").
BINARYLANE_REGION_FALLBACK="bne syd adl per"
BINARYLANE_PLAN=std-1vcpu
BINARYLANE_IMAGE=ubuntu-24.04

ADMIN_USER=localadmin
TIMEZONE=Australia/Brisbane

ENABLE_LAMP=true
ENABLE_CLOUDFLARE_TUNNEL=false
CLOUDFLARE_PROXY=false

# Optional. Only used when --enable-tls is passed. Empty is fine — certbot
# just registers with --register-unsafely-without-email (no renewal-failure
# notification emails).
LETSENCRYPT_EMAIL=

# Non-secret Cloudflare zone id for SERVER_DOMAIN — from the Cloudflare
# dashboard, or `curl .../zones?name=<domain>` with your API token.
CLOUDFLARE_ZONE_ID=

# Shared admin key used across VM/container provisioning and BinaryLane
# systems — the existing 'cipi' keypair, not a toolkit-specific generated key.
PROVISIONING_SSH_KEY=$HOME/.ssh/cipi

# Hostname resolving to the control host's public IP. Each run resolves it
# and gives that IP an explicit ufw SSH allow + fail2ban ignoreip on every
# provisioned server. Leave unset only if you have no such hostname.
MANAGEMENT_SSH_HOSTNAME=manage.example.com

# --role docker servers: IPs/CIDRs (comma-separated, IPv4 or IPv6) always
# allowed to reach Nginx Proxy Manager's port 443 directly, alongside
# Cloudflare's published ranges. Typically your own home/office addresses.
TRUSTED_443_IPS=

# Beszel monitoring agent, installed by default (--skip-beszel to opt out).
# Use the hub's TAILNET address: these servers are offsite, and a public
# hub hostname behind Cloudflare Access (or any login page) blocks the
# agent's WebSocket. Needs Tailscale (the default) and an ACL allowing
# tag:binarylane -> the hub on its port. BESZEL_HUB_KEY is the hub's public
# key (Settings > Add System); the token is BESZEL_UNIVERSAL_CODE in
# .api-auth.env, never here.
BESZEL_HUB_URL=http://beszel.<tailnet>.ts.net:8090
BESZEL_HUB_KEY=
BESZEL_PORT=45876
