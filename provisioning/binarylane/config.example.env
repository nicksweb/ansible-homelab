# Copy to config.env and adjust as needed. config.env is gitignored.
# Never put API tokens or other secrets in this file — credentials are read
# directly from the locations documented in README.md, primarily
# <repo root>/.api-auth.env (mode 600, gitignored).

SERVER_DOMAIN=example.com

# BinaryLane defaults (see README.md "Choosing region/plan/image" for the
# full list retrieved from the API).
BINARYLANE_REGION=bne
# Tried in this order if the primary region has no host capacity right now
# (a real, observed condition — "Unable to find a suitable host").
BINARYLANE_REGION_FALLBACK="bne syd adl per"
BINARYLANE_PLAN=std-1vcpu
BINARYLANE_IMAGE=ubuntu-24.04

ADMIN_USER=localadmin
TIMEZONE=Australia/Brisbane

ENABLE_LAMP=true
ENABLE_CLOUDFLARE_TUNNEL=false
CLOUDFLARE_PROXY=false

# Optional. Only used when --enable-tls is passed. Empty is fine — certbot
# just registers with --register-unsafely-without-email (no renewal-failure
# notification emails).
LETSENCRYPT_EMAIL=

# Non-secret Cloudflare zone id for SERVER_DOMAIN — from the Cloudflare
# dashboard, or `curl .../zones?name=<domain>` with your API token.
CLOUDFLARE_ZONE_ID=

# Dedicated provisioning key — created automatically on first run if missing.
PROVISIONING_SSH_KEY=$HOME/.ssh/binarylane_provisioning_ed25519
