# Local inventories and host-specific connection data
inventory
# ...except the provisioning toolkits' dynamic inventory (generic code; its
# host_vars/, which name real servers and hostnames, stay ignored below)
!provisioning/inventory/
inventory.organized
inventory.local
nbc
host_vars/
group_vars/*
!group_vars/provisioning/
!group_vars/provisioning/vault.yml

# Local SSH/reference notes
SSH_REFERENCE.local.md

# Secrets and transient Ansible files
.env
.env.*
*.retry
*.vault
vault*.yml
!group_vars/provisioning/vault.yml
*.key
*.pem

# Editor swap and backup files
*.swp
*.swo
*~

# Syncthing conflict and temporary files
*.sync-conflict-*
.syncthing.*.tmp

# Legacy site-specific files retained locally only
playbooks/create-k3s-cluster-sapve01*.yml
playbooks/vars.yml

# Proxmox/BinaryLane provisioning toolkit — non-secret local state and
# human-readable provisioning records, not meant for version control
.api-auth.env
.binarylane
provisioned-servers/
provisioned-servers-*.txt
